# This repository is an allowlisted deployment skeleton.
# Root-level user data stays local unless explicitly added here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/requirements-dev.txt
!/AGENTS.example.md
!/scripts/
!/tools/
!/config/
!/docs/
!/templates/
!/tests/
!/skills/
!/reference_packs/
!/runtime/
!/.codex/
/.codex/*
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/web_image.toml

# Reusable Python managers and web-image runtime scripts belong in Git.
/tools/*
!/tools/*.py
!/tools/chatgpt_web_image_runtime.js
!/tools/chatgpt_web_image_backend.mjs
!/tools/chatgpt_web_image_recovery.mjs
!/tools/chatgpt_web_image_live_status.mjs
!/tools/chatgpt_web_image_native_download.mjs

# One-off local scripts with hardcoded personal paths stay local.
/tools/analyze_fb2_images.py
/tools/build_beal_scene_reference_boards.py
/tools/build_moderation_diagnostic_variants.py
/tools/create_side_topology_anchor.py
/tools/extract_teal_garment_topology.py
!/tools/chatgpt_web_image_desktop_proof.js

# Private ChatGPT destination binding stays local.
/config/chatgpt_web_image.local.json
/config/chatgpt_web_image.runtime.local.json

# Local agent policy is copied from AGENTS.example.md during bootstrap.
/AGENTS.md
/.agents/
/.codex/config.toml
/.local/
node_modules/

# Local provenance and performance notes are never release artifacts.
/docs/GENERATION_RULES.md
/docs/PERFORMANCE_AUDIT_2026-09-09.md

# User-owned packs, sources, references, generations, and scratch state.
/*_PROJECT_PACK/
/*_GENERATIONS/
/BODY_REFERENCE_LIBRARY/
/GENERATION_RESULTS/
/tmp/
/.task_guard/
/*_SOURCE_COLLECTION/
/*_SELECTIONS*/
/New*/
/Body_ref/

# Never commit visual assets or common source archives by accident.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.psd
*.clip
*.kra
*.zip
*.7z
*.rar

# The only visual files allowed in Git are lightweight README previews.
!/docs/assets/
!/docs/assets/previews/
!/docs/assets/previews/*.jpg

# Test and scratch temp folders.
/tests/.pytest_*/
/tests/tmp*/
/tests/storyart-asset-catalog-*/
/.tmp*/
/.test*/
/_tmp*/
/.pytest-tmp*/
/.codex-test-tmp*/

# Python and local environment state.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and operating-system metadata.
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
